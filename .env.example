# Sandbox credentials — never commit. Copy to .env for local runs.
AWX_CLIENT_ID=put_client_id_here_without_committing
AWX_API_KEY=put_api_key_here_without_committing
AWX_BASE_URL=https://api.sandbox.airwallex.com
# Reserve policy defaults (code, not prompts — per builder guide)
RESERVE_FLOOR=5000
RESERVE_CURRENCY=USD
AUTONOMOUS_LIMIT=2000
